# Real test infra used this session (home network, behind VPN jumphost
# 10.8.0.5). Kept here commented out for reference - uncomment and comment
# out the placeholder entries above to reconnect.
# ssh -J root@10.8.0.5 root@192.168.50.170   # node1 (controlplane)
# ssh -J root@10.8.0.5 root@192.168.50.169   # node2 (worker)
[controlplane]
node1 ansible_host=192.168.50.169 ansible_user=root

[worker]
node2 ansible_host=192.168.50.188 ansible_user=root
node3 ansible_host=192.168.50.170 ansible_user=root

[all:vars]
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_common_args='-o ProxyJump=root@10.8.0.5'

